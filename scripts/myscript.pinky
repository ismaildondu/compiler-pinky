if !(true) then
    print("1 KM: "+1000+" meters \n")
else
    println("2 KM: "+2000+" meters")
end

g=9.80

if (g==9.80) then
    print("We are in earth!:" + g + "\n")
end

g=g+1

if !(g==9.80) then
    print("We are not in earth!:" + g + "\n")
end

i = 10
while i >= 1 do
    print (i+"\n")
    i = i-1
end 
